# ------------------------------------------------------------------
# OverloadHQ  – Backend Environment Variables
# ------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# Every service here is FREE (no credit card). See README for links.
# ------------------------------------------------------------------

# ---- App -----------------------------------------------------------
APP_NAME=OverloadHQ
PORT=4000
NODE_ENV=development

# ---- Database (Neon free Postgres) ---------------------------------
# Pooled connection string (for app queries):
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require&pgbouncer=true
# Direct connection string (for Prisma migrations):
DIRECT_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# ---- Auth ----------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=7d

# Optional: if set, new signups must provide this code.
# Leave blank or remove to allow open registration.
INVITE_CODE=

# ---- Frontend URL (for CORS and email links) -----------------------
FRONTEND_URL=http://localhost:3000

# ---- AI Providers (free tiers) -------------------------------------
# Primary: Google Gemini  (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Check https://ai.google.dev/models for current free model names.
GEMINI_MODEL=gemini-2.0-flash

# Fallback: Groq  (https://console.groq.com/keys)
GROQ_API_KEY=
# Check https://console.groq.com/docs/models for current free models.
GROQ_MODEL=llama-3.3-70b-versatile

# Daily AI request cap (across all users). Free Gemini = 1500 RPD.
AI_DAILY_LIMIT=100

# ---- Email (Brevo free SMTP – optional) ----------------------------
# If blank, forgot-password feature is hidden; use scripts/reset-password.ts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- Feature Flags -------------------------------------------------
FEATURE_SOCIAL=false
